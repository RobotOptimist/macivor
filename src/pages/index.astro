---
import Base from '../layouts/Base.astro'
import { getEntry, render } from 'astro:content'
import { isVisible } from '../lib/pages'
import { site } from '../site'
const home = await getEntry('pages', 'home')
const Body = home && isVisible(home) ? (await render(home)).Content : null
---
<Base title={site.homeTitle} markdown="/index.md">
  <h1 class="sr-only">{site.name}</h1>
  <div class="container-center mt-8">
    {Body && <div class="article-container mt-4"><Body /></div>}
  </div>
</Base>
