---
import { render } from 'astro:content'
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import { assertPublishable, getVisiblePages } from '../lib/pages'

export async function getStaticPaths() {
  const pages = (await getVisiblePages()).filter((p) => p.id !== 'home')
  return pages.map((page) => ({ params: { page: page.id }, props: { page } }))
}
const { page } = Astro.props
assertPublishable(page)
const { Content } = await render(page)
---
<Base title={page.data.title || `[title: ${page.id}]`} description={page.data.description} markdown={`/${page.id}.md`}>
  <PageHeader title={page.data.title || `[title: ${page.id}]`} />
  <article data-page={page.id} class="mx-auto w-full max-w-2xl px-4 sm:px-6 mt-8 text-left">
    {import.meta.env.DEV && page.data.draft && <p class="text-sm italic mb-4 max-w-none">Draft: not included in production builds.</p>}
    <div class="post prose prose-lg max-w-none">
      <Content />
    </div>
  </article>
</Base>
