---
import { getCollection, render } from 'astro:content'
import { Image } from 'astro:assets'
import Base from '../../layouts/Base.astro'
import PageHeader from '../../components/PageHeader.astro'

// `image` in frontmatter is a legacy Cloudinary public ID; match it to a local file by basename.
const heroFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/heroes/*.{png,jpg,jpeg,webp}', { eager: true })
const heroes = Object.fromEntries(
  Object.entries(heroFiles).map(([path, mod]) => [path.split('/').pop()!.replace(/\.[^.]+$/, ''), mod.default]),
)

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}
const { post } = Astro.props
const { Content } = await render(post)
const hero = post.data.image ? heroes[post.data.image.split('/').pop()!] : undefined
const date = post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
---
<Base title={post.data.title} description={post.data.description} markdown={`/blog/${post.id}.md`}>
  <PageHeader title={post.data.title} />
  <article class="mx-auto w-full max-w-2xl px-4 sm:px-6 mt-8 text-left">
    <p class="text-sm text-gray-600 mb-1 max-w-none">
      <time datetime={post.data.date.toISOString().slice(0, 10)}>{date}</time>
    </p>
    {post.data.description && <p class="text-lg text-gray-700 mb-6 max-w-none">{post.data.description}</p>}
    {hero && (
      <Image
        src={hero}
        alt={post.data.alttext ?? ''}
        widths={[480, 768, 1024]}
        sizes="(min-width: 672px) 672px, 100vw"
        class="w-full h-auto rounded-lg mb-8"
      />
    )}
    <div class="post prose prose-lg max-w-none">
      <Content />
    </div>
    <p class="mt-12 mb-4 max-w-none"><a href="/blog">&larr; Blog</a></p>
  </article>
</Base>
