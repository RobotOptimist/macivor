---
import { getEntry, render } from 'astro:content'
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'

const entry = await getEntry('resume', 'resume_doc')
if (!entry) throw new Error('resume_doc missing')
const { Content } = await render(entry)
---
<Base title={entry.data.title} description="James MacIvor's professional resume and experience" markdown="/resume.md">
  <PageHeader title="Resume" />
  <div class="resume-container mt-8">
    <div class="resume-content">
      <Content />
    </div>
  </div>
</Base>

<style>
  /* Ported from the Nuxt resume page's scoped styles (:deep -> :global). */
  .resume-container {
    @apply max-w-4xl mx-auto px-8;
  }
  .resume-content {
    @apply text-left;
    font-family: 'Roboto Slab', serif;
    line-height: 1.6;
  }
  .resume-content :global(h1) {
    @apply text-3xl font-bold mb-6 text-gray-800 border-b-2 border-indigo-500 pb-2;
  }
  .resume-content :global(h2) {
    @apply text-2xl font-semibold mb-4 mt-6 text-gray-700;
  }
  .resume-content :global(h3) {
    @apply text-xl font-semibold mb-3 mt-4 text-gray-700;
  }
  .resume-content :global(h4) {
    @apply text-lg font-semibold mb-2 mt-3 text-gray-700;
  }
  .resume-content :global(p) {
    @apply text-base mb-3 text-gray-700 leading-relaxed;
    max-width: none;
  }
  .resume-content :global(ul) {
    @apply text-left list-disc ml-6 mb-4 text-base;
  }
  .resume-content :global(ol) {
    @apply text-left list-decimal ml-6 mb-4 text-base;
  }
  .resume-content :global(li) {
    @apply mb-1 text-gray-700;
  }
  .resume-content :global(strong) {
    @apply font-semibold text-gray-800;
  }
  .resume-content :global(em) {
    @apply italic text-gray-600;
  }
  .resume-content :global(hr) {
    @apply border-gray-300 my-6;
  }
  .resume-content :global(blockquote) {
    @apply border-l-4 border-indigo-300 pl-4 italic text-gray-600 my-4;
  }
  .resume-content :global(code) {
    @apply bg-gray-100 px-2 py-1 rounded text-sm font-mono;
  }
  .resume-content :global(pre) {
    @apply bg-gray-100 p-4 rounded-lg overflow-x-auto my-4;
  }
  .resume-content :global(pre code) {
    @apply bg-transparent p-0;
  }
  .resume-content :global(table) {
    @apply w-full border-collapse border border-gray-300 my-4;
  }
  .resume-content :global(th) {
    @apply border border-gray-300 px-4 py-2 bg-gray-50 font-semibold text-left;
  }
  .resume-content :global(td) {
    @apply border border-gray-300 px-4 py-2;
  }
  .resume-content :global(a) {
    @apply text-indigo-600 hover:text-indigo-800 underline;
  }
</style>
