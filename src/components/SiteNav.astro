---
import { getVisiblePages } from '../lib/pages'

// "Resume" and "Blog" are existing site text. Other labels come from the
// navLabel in each page's frontmatter; pages without one are not linked.
const pageLinks = (await getVisiblePages())
  .filter((p) => p.id !== 'home' && p.data.navLabel.trim())
  .map((p) => ({ href: `/${p.id}`, label: p.data.navLabel, order: p.data.navOrder }))
const links = [
  { href: '/resume', label: 'Resume', order: 30 },
  { href: '/blog', label: 'Blog', order: 40 },
  ...pageLinks,
].sort((a, b) => a.order - b.order)
---
<nav class="flex items-center justify-between flex-wrap bg-indigo-700 p-4">
  <a href="/" class="flex items-center flex-shrink-0 mr-6">
    <!-- Commissioned logo; the wordmark reads "MacIvor Technical, LLC". Alt text matches it. -->
    <img src="/logo/MacIvor_Logo_White.svg" alt="MacIvor Technical, LLC" width="224" height="96" class="h-24 w-auto -my-7 -ml-4" />
  </a>
  <div class="block lg:hidden">
    <button id="menu-toggle" aria-expanded="false" aria-controls="menu"
      class="flex items-center px-3 py-2 border rounded text-indigo-200 border-indigo-400 hover:text-white hover:border-white">
      <svg class="fill-current h-3 w-3" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><title>Menu</title><path d="M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0v-2z"/></svg>
    </button>
  </div>
  <div id="menu" class="hidden w-full lg:flex lg:items-center lg:w-auto flex-grow">
    <div class="text-sm lg:flex-grow">
      {links.map((l) => (
        <a href={l.href} class="block mt-4 lg:inline-block lg:mt-0 text-indigo-200 hover:text-white mr-4">{l.label}</a>
      ))}
    </div>
  </div>
</nav>
<script>
  const btn = document.getElementById('menu-toggle')
  const menu = document.getElementById('menu')
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false
    btn.setAttribute('aria-expanded', String(open))
  })
</script>
